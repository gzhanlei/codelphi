{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codelphi.dev/schemas/behavior-inventory-v1.schema.json",
  "title": "Behavior Inventory Benchmark Comparison (v1)",
  "description": "单仓 legacy vs inventory 配对行为对照的冻结文件格式。人工评审在查看任何路径输出之前冻结 behaviors；hits 由不知道新旧来源的评审判定后回填。协议见同目录 behavior-inventory-v1.md。",
  "type": "object",
  "required": ["schema", "repo", "revision", "frozenAt", "frozenBy", "behaviors", "outputEvaluation", "processGates"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "behavior-inventory-v1" },
    "repo": { "type": "string", "minLength": 1, "description": "仓库标识，如 expressjs/express、apache/superset（冻结 fixture）" },
    "revision": {
      "type": "object",
      "required": ["beforeSha", "afterSha"],
      "additionalProperties": false,
      "properties": {
        "beforeSha": { "type": ["string", "null"], "description": "首分析为 null" },
        "afterSha": { "type": "string", "minLength": 7 }
      }
    },
    "frozenAt": { "type": "string", "format": "date-time", "description": "行为清单冻结时间（必须早于评审看到任何路径输出的时间）" },
    "frozenBy": { "type": "string", "minLength": 1, "description": "冻结人标识（评审身份，非新旧输出的生产者）" },
    "behaviors": {
      "type": "array",
      "minItems": 30,
      "description": "冻结人工行为清单；30 条是初始下限，不代表统计功效充分",
      "items": {
        "type": "object",
        "required": ["behaviorId", "sourceLocation", "description", "observableOutcome", "hits"],
        "additionalProperties": false,
        "properties": {
          "behaviorId": { "type": "string", "minLength": 1, "description": "仓内唯一行为 ID" },
          "sourceLocation": {
            "type": "object",
            "required": ["path", "startLine", "endLine"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "startLine": { "type": "integer", "minimum": 1 },
              "endLine": { "type": "integer", "minimum": 1 }
            }
          },
          "description": { "type": "string", "minLength": 1, "description": "行为描述（触发/操作）" },
          "observableOutcome": { "type": "string", "minLength": 1, "description": "外部可观察结果" },
          "evidence": {
            "type": "array",
            "description": "必要证据（代码定位列表，可为空数组但应在评审记录中说明原因）",
            "items": {
              "type": "object",
              "required": ["path"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "startLine": { "type": "integer", "minimum": 1 },
                "endLine": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "hits": {
            "type": "object",
            "required": ["legacy", "inventory"],
            "additionalProperties": false,
            "description": "盲评命中判定：命中 = 同时具备对应触发/操作、外部可观察结果和必要证据；只提到函数名不算命中",
            "properties": {
              "legacy": { "type": "boolean" },
              "inventory": { "type": "boolean" }
            }
          }
        }
      }
    },
    "outputEvaluation": {
      "type": "object",
      "required": ["legacy", "inventory"],
      "additionalProperties": false,
      "description": "误报与证据会计。分母 = 各路径实际评估的输出行为数（两路径分母互相独立；仅出现在一条路径的输出行为单独列入 unmatchedOutputs，不人为构造配对）。全部评估或分层随机评估至少 100 条输出行为。",
      "properties": {
        "legacy": { "$ref": "#/$defs/outputSide" },
        "inventory": { "$ref": "#/$defs/outputSide" }
      }
    },
    "unmatchedOutputs": {
      "type": "object",
      "additionalProperties": false,
      "description": "未匹配到任何冻结行为的输出行为描述（分别列出，不参与配对）",
      "properties": {
        "legacy": { "type": "array", "items": { "type": "string" } },
        "inventory": { "type": "array", "items": { "type": "string" } }
      }
    },
    "splitMerge": {
      "type": "object",
      "additionalProperties": false,
      "description": "行为拆分/合并计数（一个行为被拆成多个输出，或多个行为被并成一个输出），分别报告",
      "properties": {
        "legacy": { "$ref": "#/$defs/splitMergeSide" },
        "inventory": { "$ref": "#/$defs/splitMergeSide" }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "description": "未决计数（模型/编排未能判定的行为或锚点数），分别报告",
      "properties": {
        "legacy": { "type": "integer", "minimum": 0 },
        "inventory": { "type": "integer", "minimum": 0 }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "description": "实际成本遥测（同一 revision 各路径一次 run；分别报告，不作门槛）",
      "properties": {
        "legacy": { "$ref": "#/$defs/costSide" },
        "inventory": { "$ref": "#/$defs/costSide" }
      }
    },
    "processGates": {
      "type": "object",
      "required": ["inventoryManifestValid", "coverageGatesPassed", "activationGatePassed"],
      "additionalProperties": false,
      "description": "过程门禁声明：manifest 校验、双重覆盖门禁（primaryRangesOmitted=0 等）、激活门禁七项。任一 false 或缺失 → 整体 failed（exit 1），即使统计 inconclusive 也不例外；benchmark 不能抵消过程缺陷",
      "properties": {
        "inventoryManifestValid": { "type": "boolean" },
        "coverageGatesPassed": { "type": "boolean" },
        "activationGatePassed": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "outputSide": {
      "type": "object",
      "required": ["evaluatedOutputs", "falsePositives", "evidenceSupported"],
      "additionalProperties": false,
      "properties": {
        "evaluatedOutputs": { "type": "integer", "minimum": 1, "description": "该路径实际评估的输出行为数（误报/证据的分母）" },
        "falsePositives": { "type": "integer", "minimum": 0, "description": "无充分代码证据的输出行为数" },
        "evidenceSupported": { "type": "integer", "minimum": 0, "description": "证据充分的输出行为数" }
      }
    },
    "splitMergeSide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "splits": { "type": "integer", "minimum": 0 },
        "merges": { "type": "integer", "minimum": 0 }
      }
    },
    "costSide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "llmCalls": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 },
        "costAmount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string" },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
