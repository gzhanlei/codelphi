+        mocker.patch("superset.db", Mock(session=first))
+        with app.app_context(), pytest.raises(ChartUpdateFailedError):
+            UpdateChartCommand(123, {"slice_name": "Stale"}, expected_basis=basis).run()
+        assert not first.in_transaction()
