[Unit]
Description=codelphi gateway
After=network.target

[Service]
Type=simple
User=codelphi
EnvironmentFile=/data/www/codelphi/gateway.env
ExecStart=/data/www/codelphi/gateway
WorkingDirectory=/data/www/codelphi
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/data/www/codelphi/storage

[Install]
WantedBy=multi-user.target
