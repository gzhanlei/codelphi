# Public URL of Radar, without a trailing slash.
APP_URL=http://localhost:3000
DATABASE_URL=mysql://radar:replace-me@your-tencent-mysql-host:3306/radar
DATABASE_SSL=true
# Local loopback MySQL can use DATABASE_SSL=false. Keep TLS enabled on remote hosts.
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Chandler / WorkMembership OAuth application.
CHANDLER_BASE_URL=https://api.chandler.work
CHANDLER_CLIENT_ID=
CHANDLER_CLIENT_SECRET=
# Optional comma-separated restriction for special closed deployments.
# Leave empty to allow every valid Chandler identity. Do not use this for tenant membership.
AUTH_ALLOWED_EMAILS=
# Optional: platform admins who can review feedback and create Radar GitHub issues.
# RADAR_ADMIN_EMAILS=admin@example.com

# Optional: product slugs served as public read-only demos at /products/<slug>.
# Anonymous visitors can browse freely; every save/analyze action shows a demo notice instead of a request.
# Leave empty to disable (default). Example: PUBLIC_DEMO_SLUGS=reporadar
PUBLIC_DEMO_SLUGS=

# Comma-separated host[:port] allowlist for self-managed GitLab/Gitea verification.
# Exact matches only; GitLab.com is allowed by default. Example:
# REPOSITORY_HOST_ALLOWLIST=git.example.com,gitea.internal:8443
REPOSITORY_HOST_ALLOWLIST=

# GitHub credentials shared by the internal product registry.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPOSITORY=gzhanlei/radar
# Optional JSON map for architecture source verification: {"owner/repo":"/absolute/local/checkout"}
RADAR_REPOSITORY_ROOTS={}

# Existing LLMGateway or another OpenAI-compatible non-streaming endpoint.
AI_BASE_URL=http://127.0.0.1:4000
AI_API_KEY=
AI_MODEL=ds-flash
AI_TIMEOUT_MS=180000
