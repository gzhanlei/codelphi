# Public URL of Radar, without a trailing slash.
APP_URL=http://localhost:3000
DATABASE_URL=mysql://radar:replace-me@your-tencent-mysql-host:3306/radar
DATABASE_SSL=true
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Chandler / WorkMembership OAuth application.
CHANDLER_BASE_URL=https://api.chandler.work
CHANDLER_CLIENT_ID=
CHANDLER_CLIENT_SECRET=
# Comma-separated allowlist. Required before exposing Radar to other users.
AUTH_ALLOWED_EMAILS=

# GitHub credentials shared by the internal product registry.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPOSITORY=gzhanlei/radar

# Existing LLMGateway or another OpenAI-compatible non-streaming endpoint.
AI_BASE_URL=http://127.0.0.1:4000
AI_API_KEY=
AI_MODEL=ds-flash
AI_TIMEOUT_MS=180000
